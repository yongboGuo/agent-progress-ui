{
  "name": "@agent-progress-ui/mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "@agent-progress-ui/core": "file:../core"
  },
  "scripts": {
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch --silent",
    "build": "tsup src/index.ts --format esm,cjs --dts --silent",
    "lint": "eslint src test --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  }
}
